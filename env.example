# Root-level environment variables shared across the monorepo

# Node environment
NODE_ENV=development

# Web app
NEXT_PUBLIC_STACKS_API_URL=https://api.mainnet.hiro.so
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Mobile app
EXPO_PUBLIC_STACKS_API_URL=https://api.mainnet.hiro.so

# Backend API
API_PORT=4000
API_LOG_LEVEL=debug

# Contracts / Clarinet
STACKS_NETWORK=devnet


