# Root-level environment variables shared across the monorepo

# Node environment
NODE_ENV=development

# Stacks Blockchain Configuration
STACKS_NETWORK=testnet
STACKS_PRIVATE_KEY=your_private_key_here

# Contract Configuration
NEXT_PUBLIC_CONTRACT_ADDRESS=
NEXT_PUBLIC_CONTRACT_NAME=social-platform
NEXT_PUBLIC_NETWORK=testnet
NEXT_PUBLIC_STACKS_API_URL=https://api.testnet.hiro.so

# IPFS Configuration (Pinata)
NEXT_PUBLIC_PINATA_API_KEY=your_pinata_api_key
NEXT_PUBLIC_PINATA_SECRET_KEY=your_pinata_secret_key
NEXT_PUBLIC_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/

# Web app
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
TOKEN_ADDRESS=0x9a53B191fC905179Ee908CC6086FCc0C4c6744f4
NEXT_PUBLIC_TOKEN_ADDRESS=0x9a53B191fC905179Ee908CC6086FCc0C4c6744f4

# Mobile app
EXPO_PUBLIC_STACKS_API_URL=https://api.testnet.hiro.so

# Backend API (Optional - for indexing)
API_PORT=4000
API_LOG_LEVEL=debug
JWT_SECRET=change_this_secret_in_production
MONGODB_URI=mongodb://localhost:27017/stackx

# Database (Optional - for indexing)
DATABASE_URL=postgresql://user:password@localhost:5432/stackx



