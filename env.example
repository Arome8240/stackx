# Root-level environment variables shared across the monorepo

# Node environment
NODE_ENV=development

# Web app
NEXT_PUBLIC_STACKS_API_URL=https://api.mainnet.hiro.so
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_TOKEN_ADDRESS=your_deployed_token_address_here
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id

# Mobile app
EXPO_PUBLIC_STACKS_API_URL=https://api.mainnet.hiro.so

# Backend API
API_PORT=4000
API_LOG_LEVEL=debug
JWT_SECRET=change_this_secret_in_production
MONGODB_URI=mongodb://localhost:27017/staxial

# Contracts / Clarinet
STACKS_NETWORK=devnet


