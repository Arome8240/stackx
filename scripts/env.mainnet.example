# =============================================================================
# StackX — Mainnet Deployment Environment
# Copy to: .env.mainnet  (never commit that file)
# =============================================================================

# ── Stacks wallet ──────────────────────────────────────────────────────────────
# This key pays real STX. Keep it in a secrets manager, not plain text.
# Ensure this address holds enough STX for contract deployment + fees (~1 STX).
STACKS_PRIVATE_KEY=your_64_char_hex_private_key_here
DEPLOYER_STX_ADDRESS=SP1PQHQKV0RJXZFY1DGX8MNSNYVE3VGZJSRCHNEAT

# ── Contract (filled automatically after deployment) ──────────────────────────
CONTRACT_ADDRESS=

# ── Database ──────────────────────────────────────────────────────────────────
# Use a dedicated production cluster with backups enabled.
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/stackx_prod

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate: openssl rand -hex 64
JWT_SECRET=replace_with_64_char_random_hex
JWT_EXPIRES_IN=7d

# ── App URLs ──────────────────────────────────────────────────────────────────
API_URL=https://api.stackx.app/api/v1
APP_URL=https://stackx.app

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=https://stackx.app,https://www.stackx.app

# ── Stacks network config ─────────────────────────────────────────────────────
NEXT_PUBLIC_STACKS_NETWORK=mainnet
NEXT_PUBLIC_STACKS_API_URL=https://api.hiro.so
NEXT_PUBLIC_CONTRACT_NAME=social-platform-v2

# ── IPFS / Pinata ─────────────────────────────────────────────────────────────
PINATA_JWT=your_pinata_jwt
PINATA_API_KEY=your_pinata_api_key
PINATA_SECRET_API_KEY=your_pinata_secret
NEXT_PUBLIC_PINATA_GATEWAY=https://gateway.pinata.cloud/ipfs

# ── Docker ────────────────────────────────────────────────────────────────────
DOCKER_REGISTRY=ghcr.io/your-org/stackx
DOCKER_IMAGE_TAG=mainnet-latest

# ── Rate limiting (tighter for production) ───────────────────────────────────
THROTTLE_SHORT_LIMIT=10
THROTTLE_LONG_LIMIT=100
