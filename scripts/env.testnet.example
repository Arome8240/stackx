# =============================================================================
# StackX — Testnet Deployment Environment
# Copy to: .env.testnet  (never commit that file)
# =============================================================================

# ── Stacks wallet ──────────────────────────────────────────────────────────────
# Private key of the account that will sign and pay for deployment.
# Get testnet STX from: https://explorer.hiro.so/sandbox/faucet?chain=testnet
STACKS_PRIVATE_KEY=your_64_char_hex_private_key_here
DEPLOYER_STX_ADDRESS=ST1PQHQKV0RJXZFY1DGX8MNSNYVE3VGZJSRTPGZGM

# ── Contract (filled automatically after deployment) ──────────────────────────
# Leave empty on first run; deploy.sh will populate after contract deploy.
CONTRACT_ADDRESS=

# ── Database ──────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/stackx_testnet

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate: openssl rand -hex 64
JWT_SECRET=replace_with_64_char_random_hex
JWT_EXPIRES_IN=7d

# ── App URLs ──────────────────────────────────────────────────────────────────
API_URL=https://api-testnet.stackx.app/api/v1
APP_URL=https://testnet.stackx.app

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=https://testnet.stackx.app

# ── Stacks network config ─────────────────────────────────────────────────────
NEXT_PUBLIC_STACKS_NETWORK=testnet
NEXT_PUBLIC_STACKS_API_URL=https://api.testnet.hiro.so
NEXT_PUBLIC_CONTRACT_NAME=social-platform-v2

# ── IPFS / Pinata ─────────────────────────────────────────────────────────────
PINATA_JWT=your_pinata_jwt
PINATA_API_KEY=your_pinata_api_key
PINATA_SECRET_API_KEY=your_pinata_secret
NEXT_PUBLIC_PINATA_GATEWAY=https://gateway.pinata.cloud/ipfs

# ── Docker (optional, for docker-compose deploys) ────────────────────────────
DOCKER_REGISTRY=ghcr.io/your-org/stackx
DOCKER_IMAGE_TAG=testnet-latest

# ── Rate limiting ─────────────────────────────────────────────────────────────
THROTTLE_SHORT_LIMIT=20
THROTTLE_LONG_LIMIT=200
